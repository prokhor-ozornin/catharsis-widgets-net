<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Catharsis.Web.Widgets</AssemblyName>
    <RootNamespace>Catharsis.Web.Widgets</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0</Version>
    <Company>Prokhor Ozornin &lt;prokhor.ozornin@yandex.ru&gt;</Company>
    <Authors>Prokhor Ozornin &lt;prokhor.ozornin@yandex.ru&gt;</Authors>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <DocumentationFile>API.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="packages.config" />
    <None Remove="Scripts\WebWidgets\cackle.js" />
    <None Remove="Scripts\WebWidgets\disqus.js" />
    <None Remove="Scripts\WebWidgets\google_analytics.js" />
    <None Remove="Scripts\WebWidgets\google_plusone.js" />
    <None Remove="Scripts\WebWidgets\twitter_initialize.js" />
    <None Remove="web.config" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="packages.config" />
    <Content Include="Scripts\WebWidgets\cackle.js" />
    <Content Include="Scripts\WebWidgets\disqus.js" />
    <Content Include="Scripts\WebWidgets\google_analytics.js" />
    <Content Include="Scripts\WebWidgets\google_plusone.js" />
    <Content Include="Scripts\WebWidgets\twitter_initialize.js" />
    <Content Include="web.config" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Catharsis.Extensions">
      <HintPath>..\..\..\Catharsis.Extensions\src\Catharsis.Extensions.Core\bin\Release\net8.0\Catharsis.Extensions.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="resources.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>resources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
